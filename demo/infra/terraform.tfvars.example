# cp terraform.tfvars.example terraform.tfvars puis remplir les deux secrets.
# terraform.tfvars est dans le .gitignore : il ne part pas dans le dépôt.

api_app_secret       = "REMPLACER" # openssl rand -hex 16
photobook_app_secret = "REMPLACER" # openssl rand -hex 16

# Les domaines ne sont pas à choisir : Clever en attribue un à chaque app, et
# `tofu output` les donne après l'apply.

# Après le premier apply, pour resserrer le CORS de l'API sur le seul domaine
# de PhotoPrint au lieu de tout cleverapps.io :
# cors_allow_origin = "^https://app-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\\.cleverapps\\.io$"
