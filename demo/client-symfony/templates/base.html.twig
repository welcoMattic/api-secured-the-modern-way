<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PhotoBook · client confidentiel{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%234f46e5%22/><text y=%22.92em%22 x=%22.5em%22 text-anchor=%22middle%22 font-size=%2252%22 fill=%22%23fff%22 font-family=%22system-ui%22>PB</text></svg>">
        {% block stylesheets %}
        <style>
            /* Polices du deck, auto-hébergées dans public/fonts : aucune requête
               vers un CDN, la démo reste identique hors ligne. */
            @font-face {
                font-family: "Inter Variable";
                font-style: normal;
                font-display: swap;
                font-weight: 100 900;
                src: url("/fonts/inter-latin-wght-normal.woff2") format("woff2-variations");
            }

            @font-face {
                font-family: "Sora Variable";
                font-style: normal;
                font-display: swap;
                font-weight: 100 800;
                src: url("/fonts/sora-latin-wght-normal.woff2") format("woff2-variations");
            }

            /* =========================================================
               Tokens repris tels quels de theme/styles/tokens.css.
               Même vocabulaire que l'app cliente JS : les deux écrans
               doivent se lire comme un seul produit.
               ========================================================= */
            :root {
                --c-bg: #ffffff;
                --c-surface: #f6f8fb;
                --c-fg: #0e131f;
                --c-muted: #57637a;
                --c-border: #dce3ec;
                --c-border-strong: #c2ccda;

                --a-1: #0d9488;
                --a-4: #4f46e5;
                --a-7: #c32186;

                --sec: var(--a-4);
                --ok: var(--a-1);
                --ko: var(--a-7);

                --radius: .85rem;
                --radius-lg: 1.25rem;
                --radius-pill: 999px;
                --shadow-card: 0 1px 2px rgba(14, 19, 31, .05), 0 8px 24px rgba(14, 19, 31, .06);

                /* Pile emoji du deck. Sans elle, le navigateur peint l'emoji avec une
                   police de repli puis re-resout vers la police emoji couleur. */
                --font-emoji: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", "Twemoji Mozilla";

                --font-sans: "Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif, var(--font-emoji);
                --font-display: "Sora Variable", Sora, Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif, var(--font-emoji);
                --font-mono: "Fira Code", ui-monospace, SFMono-Regular, Menlo, monospace, var(--font-emoji);
            }

            *, *::before, *::after { box-sizing: border-box; }

            /* =========================================================
               LA loi de la page : elle ne défile jamais. La chaîne
               min-height:0 va de body jusqu'aux zones scrollables.
               ========================================================= */
            html, body { height: 100%; }

            body {
                margin: 0;
                overflow: hidden;
                display: grid;
                grid-template-rows: 1fr;
                background: var(--c-bg);
                color: var(--c-fg);
                font-family: var(--font-sans);
                font-size: clamp(15px, 1.05vw, 18px);
                line-height: 1.55;
                -webkit-font-smoothing: antialiased;
            }

            #app {
                min-height: 0;
                display: grid;
                grid-template-rows: 1fr;
                width: 100%;
                max-width: 1760px;
                margin: 0 auto;
                padding: clamp(1.25rem, 2.2vw, 2.25rem);
            }

            code { font-family: var(--font-mono); font-size: .95em; }
            a { color: var(--sec); }

            /* Le tick d'accent du deck, repris sous le titre. */
            .tick::after {
                content: "";
                display: block;
                width: 2.75rem;
                height: 4px;
                margin: .6rem auto 0;
                border-radius: var(--radius-pill);
                background: var(--sec);
            }

            /* ================= État déconnecté ================= */
            .hero {
                min-height: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
            }

            .hero .role__icon { font-size: 2.1em; }

            .hero .role {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: .45rem;
                margin: 0 0 .5rem;
                font-size: clamp(.85rem, 1.05vw, .95rem);
                font-weight: 600;
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--c-muted);
            }

            .hero h1 {
                font-family: var(--font-display);
                font-size: clamp(2.25rem, 4.2vw, 3.4rem);
                font-weight: 700;
                letter-spacing: -.02em;
                margin: 0;
            }

            .hero .eyebrow {
                font-family: var(--font-mono);
                font-size: clamp(.9rem, 1.3vw, 1.1rem);
                color: var(--sec);
                margin: .35rem 0 2rem;
            }

            .hero .note {
                margin: 2rem 0 0;
                color: var(--c-muted);
                font-size: clamp(1rem, 1.25vw, 1.15rem);
            }

            .btn-primary {
                font-family: var(--font-display);
                font-size: clamp(1rem, 1.6vw, 1.2rem);
                font-weight: 600;
                padding: clamp(.75rem, 1.2vw, 1rem) clamp(1.5rem, 2.4vw, 2rem);
                background: var(--sec);
                color: #fff;
                border: none;
                border-radius: var(--radius);
                cursor: pointer;
                text-decoration: none;
                display: inline-block;
                transition: opacity .15s;
            }

            .btn-primary:hover { opacity: .9; }

            /* ================= État connecté ================= */
            .workbench {
                min-height: 0;
                display: grid;
                grid-template-rows: auto 1fr;
                gap: clamp(1rem, 1.6vw, 1.6rem);
            }

            .topbar {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
            }

            .topbar h1 {
                font-family: var(--font-display);
                font-size: clamp(1.4rem, 2.1vw, 1.9rem);
                font-weight: 700;
                letter-spacing: -.015em;
                margin: 0;
            }

            .role__icon {
                font-size: 1.35em;
                line-height: 1;
                letter-spacing: 0;
            }

            .role-inline {
                margin-left: .55rem;
                padding: .2rem .6rem;
                border-radius: var(--radius-pill);
                background: rgba(79, 70, 229, .1);
                color: var(--sec);
                font-family: var(--font-sans);
                font-size: .55em;
                font-weight: 600;
                letter-spacing: .04em;
                text-transform: uppercase;
                vertical-align: middle;
                white-space: nowrap;
            }

            .topbar .eyebrow {
                font-family: var(--font-mono);
                font-size: clamp(.78rem, 1vw, .92rem);
                color: var(--sec);
                margin: .2rem 0 0;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-pill {
                display: inline-flex;
                align-items: center;
                padding: .4rem 1rem;
                border-radius: var(--radius-pill);
                background: rgba(79, 70, 229, .1);
                color: var(--sec);
                font-weight: 600;
                font-size: clamp(.95rem, 1.25vw, 1.1rem);
            }

            .btn-secondary {
                font-family: var(--font-sans);
                font-size: clamp(.85rem, 1.1vw, .95rem);
                padding: .45rem .9rem;
                background: transparent;
                color: var(--c-muted);
                border: 1px solid var(--c-border-strong);
                border-radius: var(--radius);
                cursor: pointer;
                text-decoration: none;
                transition: color .15s, border-color .15s;
            }

            .btn-secondary:hover { color: var(--c-fg); border-color: var(--sec); }

            /* Même partage que PhotoPrint : l'identité est une référence qu'on
               consulte, la réponse de l'API est ce qu'on lit à voix haute. */
            .main-area {
                min-height: 0;
                display: grid;
                grid-template-columns: 1fr 2fr;
                gap: clamp(.9rem, 1.4vw, 1.4rem);
            }

            /* ================= Cartes ================= */
            .card {
                min-height: 0;
                display: grid;
                grid-template-rows: auto 1fr;
                background: var(--c-surface);
                border: 1px solid var(--c-border);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-card);
                overflow: hidden;
            }

            .card-head {
                padding: clamp(.85rem, 1.2vw, 1.15rem) clamp(1rem, 1.4vw, 1.35rem);
                border-bottom: 1px solid var(--c-border);
            }

            .card-head h2 {
                font-family: var(--font-display);
                font-size: clamp(1.05rem, 1.4vw, 1.35rem);
                font-weight: 700;
                margin: 0;
            }

            .card-head .subtitle {
                margin: .15rem 0 0;
                color: var(--c-muted);
                font-size: clamp(.8rem, 1.02vw, .92rem);
            }

            .card-body {
                min-height: 0;
                display: grid;
                grid-template-rows: auto 1fr;
                gap: clamp(.7rem, 1vw, 1rem);
                padding: clamp(.85rem, 1.2vw, 1.15rem) clamp(1rem, 1.4vw, 1.35rem) clamp(1rem, 1.4vw, 1.35rem);
            }

            .claims {
                margin: 0;
                display: grid;
                grid-template-columns: auto minmax(0, 1fr);
                column-gap: .85rem;
                row-gap: .3rem;
                align-items: baseline;
                font-family: var(--font-mono);
                font-size: clamp(.88rem, 1.08vw, 1rem);
            }

            .claims dt { color: var(--c-muted); white-space: nowrap; }
            .claims dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
            .claims dd.is-emphasised { color: var(--sec); font-weight: 700; }

            .card-note {
                min-height: 0;
                overflow: auto;
                align-self: start;
                margin: 0;
                padding: .85rem 1rem;
                background: var(--c-bg);
                border: 1px solid var(--c-border);
                border-left: 3px solid var(--sec);
                border-radius: var(--radius);
                color: var(--c-muted);
                font-size: clamp(.85rem, 1.05vw, .98rem);
            }

            .card-note strong { color: var(--c-fg); }

            /* ================= Appel à l'API ================= */
            .actions {
                display: flex;
                flex-direction: column;
                gap: clamp(.5rem, .75vw, .7rem);
            }

            .actions form { margin: 0; }

            .api-btn {
                width: 100%;
                font-family: var(--font-sans);
                font-size: clamp(.92rem, 1.15vw, 1.05rem);
                text-align: left;
                padding: clamp(.6rem, .9vw, .8rem) clamp(.8rem, 1.1vw, 1rem);
                background: var(--c-bg);
                color: var(--c-fg);
                border: 1.5px solid var(--c-border-strong);
                border-radius: var(--radius);
                cursor: pointer;
                transition: border-color .15s, transform .15s;
            }

            .api-btn:hover { border-color: var(--sec); transform: translateY(-1px); }

            .api-btn small {
                display: block;
                margin-top: .15rem;
                font-size: .78em;
                color: var(--c-muted);
            }

            /* Le contre-exemple : un refus attendu, pas une panne. */
            .api-btn.is-counter {
                border-color: var(--ko);
                color: var(--ko);
                background: rgba(195, 33, 134, .05);
            }

            .api-btn.is-counter small { color: var(--ko); opacity: .8; }
            .api-btn.is-counter:hover { background: rgba(195, 33, 134, .1); border-color: var(--ko); }

            /* Le nombre d'enfants varie (statut, challenge, indice, corps). Le flex les
               dimensionne tous automatiquement, et seul le corps absorbe la place restante
               puis défile : la carte ne grandit jamais. */
            .response {
                min-height: 0;
                display: flex;
                flex-direction: column;
                gap: .6rem;
            }

            .response > .response-body { flex: 1; min-height: 0; }

            .response-challenge {
                margin: 0;
                padding: .5rem .7rem;
                border-radius: var(--radius);
                background: rgba(195, 33, 134, .07);
                color: var(--ko);
                font-family: var(--font-mono);
                font-size: clamp(.72rem, .84vw, .84rem);
                line-height: 1.45;
                overflow-wrap: anywhere;
            }

            .response-hint {
                margin: 0;
                padding: .5rem .7rem;
                border-radius: var(--radius);
                background: rgba(79, 70, 229, .08);
                border-left: 3px solid var(--sec);
                color: var(--c-fg);
                font-size: clamp(.8rem, .98vw, .92rem);
            }

            .response-idle {
                margin: 0;
                align-self: start;
                color: var(--c-muted);
                font-size: clamp(.85rem, 1.05vw, .95rem);
                font-style: italic;
            }

            .response-head {
                display: flex;
                align-items: baseline;
                gap: .7rem;
            }

            .status-chip {
                font-family: var(--font-mono);
                font-size: clamp(2.2rem, 3.2vw, 3.2rem);
                font-weight: 700;
                line-height: 1;
                letter-spacing: -.02em;
            }

            .status-chip.is-ok { color: var(--ok); }
            .status-chip.is-ko { color: var(--ko); }

            .status-label { font-size: clamp(.9rem, 1.15vw, 1.05rem); color: var(--c-muted); }

            .response-body {
                min-height: 0;
                overflow: auto;
                margin: 0;
                padding: .7rem .85rem;
                background: var(--c-bg);
                border: 1px solid var(--c-border);
                border-radius: var(--radius);
                font-family: var(--font-mono);
                font-size: clamp(.72rem, .84vw, .88rem);
                line-height: 1.5;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            /* Repli pour une fenêtre étroite, pas pour la projection. */
            @media (max-width: 900px) {
                .main-area { grid-template-columns: 1fr; }
            }
        </style>
        {% endblock %}
    </head>
    <body>
        <div id="app">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
