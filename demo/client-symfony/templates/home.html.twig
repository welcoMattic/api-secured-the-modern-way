{% extends 'base.html.twig' %}

{% block title %}App cliente Symfony - démo OIDC{% endblock %}

{% block body %}
{% if app.user %}
    <section class="workbench">
        <header class="topbar">
            <div>
                <h1>App cliente Symfony</h1>
                <p class="eyebrow">authorization_code · drenso/symfony-oidc-bundle</p>
            </div>
            <div class="topbar-right">
                <span class="user-pill">{{ app.user.preferredUsername }}</span>
                <a href="{{ path('app_logout') }}" class="btn-secondary">Se déconnecter</a>
            </div>
        </header>

        <div class="main-area">
            <article class="card">
                <div class="card-head">
                    <h2>Identité fournie par l'OP</h2>
                    <p class="subtitle">aucun compte, aucun mot de passe dans cette application</p>
                </div>
                <div class="card-body">
                    <dl class="claims">
                        <dt>sub</dt><dd class="is-emphasised">{{ app.user.sub }}</dd>
                        <dt>preferred_username</dt><dd>{{ app.user.preferredUsername }}</dd>
                        <dt>email</dt><dd>{{ app.user.email }}</dd>
                    </dl>
                    <p class="card-note">
                        L'application ne reçoit que <strong>ROLE_USER</strong>, et rien d'autre.
                        Les permissions sur les photos sont décidées par l'<strong>API</strong>,
                        à partir de l'access token. Jamais ici.
                    </p>
                </div>
            </article>

            <article class="card">
                <div class="card-head">
                    <h2>Appeler l'API</h2>
                    <p class="subtitle">le serveur relaie l'access token de la session</p>
                </div>
                <div class="card-body">
                    <div class="actions">
                        <form action="{{ path('app_photos_list') }}" method="post">
                            <button type="submit" class="api-btn">GET <code>/api/photos</code></button>
                        </form>
                        <form action="{{ path('app_photos_create') }}" method="post">
                            <button type="submit" class="api-btn">POST <code>/api/photos</code></button>
                        </form>
                    </div>

                    <div class="response">
                        {% set results = app.flashes('api_result') %}
                        {% if results is empty %}
                            <p class="response-idle">Aucun appel pour l'instant.</p>
                        {% else %}
                            {% for result in results %}
                                {% set ok = result.status >= 200 and result.status < 300 %}
                                {% set injoignable = result.status == 0 %}
                                <div class="response-head">
                                    <span class="status-chip {{ ok ? 'is-ok' : 'is-ko' }}">{{ injoignable ? '!' : result.status }}</span>
                                    <span class="status-label">
                                        {{ injoignable ? 'API injoignable' : (ok ? 'OK' : "refusé par l'API") }}
                                    </span>
                                </div>
                                {% if result.challenge %}
                                    <p class="response-challenge">WWW-Authenticate: {{ result.challenge }}</p>
                                {% endif %}
                                {% if result.status == 401 %}
                                    {# Se croire connecté et récolter un 401 : le token n'est plus
                                       vérifiable. Cas classique quand Keycloak a redémarré. #}
                                    <p class="response-hint">
                                        Ce token n'est plus accepté : le Provider a sans doute redémarré.
                                        <a href="{{ path('app_session_forget') }}">Oublier la session</a>,
                                        puis se reconnecter.
                                    </p>
                                {% endif %}
                                <pre class="response-body">{{ result.body }}</pre>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </article>
        </div>
    </section>
{% else %}
    <section class="hero">
        <h1 class="tick">App cliente Symfony</h1>
        <p class="eyebrow">authorization_code · drenso/symfony-oidc-bundle</p>
        <a href="{{ path('app_login') }}" class="btn-primary">Se connecter avec Keycloak</a>
        <p class="note">
            Cette app ne connaît aucun mot de passe.<br>
            Elle confie l'authentification à l'OIDC Provider.
        </p>
    </section>
{% endif %}
{% endblock %}
