{% extends 'base.html.twig' %}

{% block title %}Client Symfony - API Secured{% endblock %}

{% block body %}
    {% if app.user %}
        {# Utilisateur connecte #}
        <div class="logged-in">
            <div class="topbar">
                <div class="topbar-left">
                    <h1>App cliente Symfony</h1>
                    <span class="eyebrow">authorization_code · drenso/symfony-oidc-bundle</span>
                </div>
                <div class="topbar-right">
                    <span class="user-pill"><strong>{{ app.user.preferredUsername }}</strong></span>
                    <a href="{{ path('app_logout') }}" class="btn-secondary">Se déconnecter</a>
                </div>
            </div>

            <div class="main-area">
                <div class="card">
                    <div class="card-header">
                        <h2>Identite fournie par l'OP</h2>
                    </div>
                    <div class="card-body">
                        <div class="key-claims">
                            <div class="row"><span class="key">sub</span><span class="value">{{ app.user.sub }}</span></div>
                            <div class="row"><span class="key">preferred_username</span><span class="value">{{ app.user.preferredUsername }}</span></div>
                            <div class="row"><span class="key">email</span><span class="value">{{ app.user.email }}</span></div>
                        </div>
                        <p class="note">
                            L'app ne recoit que <code>ROLE_USER</code>. Les permissions photos sont decidees par l'API a partir de l'access token.
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h2>Appeler l'API</h2>
                    </div>
                    <div class="card-body">
                        <div class="actions">
                            <form action="{{ path('app_photos_list') }}" method="post">
                                <button type="submit">GET /api/photos</button>
                            </form>
                            <form action="{{ path('app_photos_create') }}" method="post">
                                <button type="submit">POST /api/photos</button>
                            </form>
                        </div>
                        <div class="result-panel">
                            {% for flash in app.flashes('api_result') %}
                                {% set status = flash.status %}
                                {% set body = flash.body %}
                                {% set isSuccess = status >= 200 and status < 300 %}
                                {% set statusChipColor = isSuccess ? 'var(--ok)' : 'var(--ko)' %}
                                {% set label = isSuccess ? 'OK' : 'Erreur' %}

                                <div class="response-header">
                                    <span class="status-chip" style="color: {{ statusChipColor }}">{{ status }}</span>
                                    <span class="status-label">{{ label }}</span>
                                </div>
                                <pre>{{ body }}</pre>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        {# Utilisateur non connecte #}
        <div class="logged-out">
            <h1>App cliente Symfony</h1>
            <span class="eyebrow">authorization_code · drenso/symfony-oidc-bundle</span>
            <p class="note">L'app ne connaît aucun mot de passe. Elle confie l'authentification au Provider.</p>
            <a href="{{ path('app_login') }}" class="btn-primary">Se connecter avec Keycloak</a>
        </div>
    {% endif %}

    {# Show the appropriate state #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loggedOut = document.querySelector('.logged-out');
            const loggedIn = document.querySelector('.logged-in');
            if (loggedOut) loggedOut.style.display = {{ app.user ? 'none' : 'flex' }};
            if (loggedIn) loggedIn.style.display = {{ app.user ? 'grid' : 'none' }};
        });
    </script>
{% endblock %}
