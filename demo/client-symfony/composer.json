{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/apache-pack": "*",
        "symfony/asset": "8.2.*",
        "symfony/console": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/runtime": "8.2.*",
        "symfony/security-bundle": "8.2.*",
        "symfony/security-core": "8.2.*",
        "symfony/security-http": "8.2.*",
        "symfony/twig-bundle": "8.2.*",
        "symfony/yaml": "8.2.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "web-token/jwt-library": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": [],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "8.2.*",
        "symfony/css-selector": "8.2.*"
    }
}
