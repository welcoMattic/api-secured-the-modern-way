  "clients": [
    {
      "clientId": "photoprint",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://photoprint-demo.cleverapps.io/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://photoprint-demo.cleverapps.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://photoprint-demo.cleverapps.io/*"
      },
      "protocolMappers": [
        {
          "name": "cloudpics-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cloudpics-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "false",
            "id.token.claim": "false"
          }
        }
      ],
      "name": "PhotoPrint",
      "description": "Client public tiers. Tourne dans le navigateur d'Alice, ne peut garder aucun secret : PKCE S256."
    },
    {
