{
  "realm": "photos",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "PHOTOS_READ"
      },
      {
        "name": "PHOTOS_WRITE"
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Martin",
      "email": "alice@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PHOTOS_READ",
        "PHOTOS_WRITE"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Durand",
      "email": "bob@example.com",
